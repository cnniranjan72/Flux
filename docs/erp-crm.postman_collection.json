                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/stock-movements",
              "host": ["{{base_url}}"],
              "path": ["products", "stock-movements"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantityChanged\": 25,\n  \"movementType\": \"IN\",\n  \"reason\": \"Manual restock\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Stock movement ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}/movements",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}", "movements"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sales Challans",
      "item": [
        {
          "name": "List challans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans?take=10",
              "host": ["{{base_url}}"],
              "path": ["challans"],
              "query": [
                {
                  "key": "take",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create draft challan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create draft challan', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('challan_id', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans",
              "host": ["{{base_url}}"],
              "path": ["challans"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 10\n    }\n  ]\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create & confirm challan (deducts stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/challans",
              "host": ["{{base_url}}"],
              "path": ["challans"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 5\n    }\n  ]\n}"
            }
          },
          "response": []
        },
        {
          "name": "Confirm draft challan",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
