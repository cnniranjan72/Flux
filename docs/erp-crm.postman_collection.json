            ],
            "url": {
              "raw": "{{base_url}}/products?take=10",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "take",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Low stock products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?lowStock=true",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "lowStock",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
