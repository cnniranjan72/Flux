{
  "info": {
    "name": "ERP/CRM Operations Portal",
    "description": "Collection for the Mini ERP + CRM system. Run `POST /auth/login` first — its test script automatically stores the returned JWT in the collection variable `token`. All other requests use `{{base_url}}` and `Bearer {{token}}`.\n\nDefault local base URL: http://localhost:5000/api\nTest users (password: password123):\n- admin@test.com (ADMIN)\n- sales@test.com (SALES)\n- warehouse@test.com (WAREHOUSE)\n- accounts@test.com (ACCOUNTS)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "challan_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@test.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Register user (admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user@test.com\",\n  \"password\": \"password123\",\n  \"name\": \"New User\",\n  \"role\": \"SALES\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers?take=10",
              "host": ["{{base_url}}"],
              "path": ["customers"],
              "query": [
                {
                  "key": "take",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers?search=sunil&status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["customers"],
              "query": [
                {
                  "key": "search",
                  "value": "sunil"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get customer detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create customer', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('customer_id', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers",
              "host": ["{{base_url}}"],
              "path": ["customers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"mobile\": \"9000000000\",\n  \"email\": \"test@customer.com\",\n  \"businessName\": \"Test Business\",\n  \"gstNumber\": \"27ABCDE1234F1Z5\",\n  \"type\": \"Wholesale\",\n  \"address\": \"1, Test Street, Pune\",\n  \"status\": \"LEAD\",\n  \"notes\": \"Created via Postman\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"followUpDate\": \"2026-09-01T10:00:00Z\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Add follow-up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}/follow-ups",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}", "follow-ups"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Called customer; interested in LED range.\",\n  \"nextFollowDate\": \"2026-09-05T10:00:00Z\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products & Stock",
